{
  "name": "dragonball-rpg-origens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Protótipo 3D estilizado de aventura e combate para navegador",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
